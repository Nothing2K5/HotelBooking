@{
    ViewBag.Title = "Xóa tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6">
        <div class="card border-danger shadow">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="fas fa-exclamation-triangle"></i> Xóa tài khoản vĩnh viễn</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-danger border-danger bg-danger bg-opacity-10">
                    <h5><i class="fas fa-exclamation-circle"></i> Cảnh báo quan trọng!</h5>
                    <p class="mb-0">Hành động này <strong>không thể hoàn tác</strong>. Khi xóa tài khoản:</p>
                    <ul class="mb-2">
                        <li>Bạn sẽ mất toàn bộ lịch sử đặt phòng.</li>
                        <li>Điểm tích lũy và hạng thành viên sẽ bị xóa bỏ.</li>
                        <li>Bạn sẽ không thể đăng nhập lại bằng email này.</li>
                    </ul>
                </div>

                <p>Nếu bạn chắc chắn muốn tiếp tục, vui lòng nhập mật khẩu xác nhận bên dưới:</p>

                <form id="deleteAccountForm">
                    <div class="form-group mb-3">
                        <label for="password" class="form-label fw-bold">Mật khẩu của bạn</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-lock"></i></span>
                            <input type="password" class="form-control" id="password" name="password" required placeholder="Nhập mật khẩu để xác nhận">
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" id="confirmCheckbox" required>
                        <label class="form-check-label text-danger fw-bold" for="confirmCheckbox">
                            Tôi hiểu hậu quả và đồng ý xóa tài khoản.
                        </label>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger btn-lg" id="btnDelete">
                            <i class="fas fa-trash-alt"></i> Xác nhận xóa tài khoản
                        </button>
                        <a href="/Customer/Profile/Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $("#deleteAccountForm").submit(function (e) {
                e.preventDefault();

                // Kiểm tra checkbox
                if (!$("#confirmCheckbox").is(":checked")) {
                    alert("Vui lòng tích vào ô xác nhận đồng ý.");
                    return;
                }

                var password = $("#password").val();
                if (!password) {
                    alert("Vui lòng nhập mật khẩu.");
                    return;
                }

                if (!confirm("CẢNH BÁO CUỐI CÙNG: Bạn có thực sự muốn xóa tài khoản?")) {
                    return;
                }

                var btn = $("#btnDelete");
                var originalText = btn.html();
                btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm"></span> Đang xử lý...');

                $.ajax({
                    type: "POST",
                    url: '/Customer/Profile/DeleteAccount',
                    data: JSON.stringify({ password: password }),
                    contentType: "application/json; charset=utf-8",
                    success: function (response) {
                        if (response.success) {
                            alert(response.message);
                            // Chuyển hướng về trang chủ sau khi xóa và đăng xuất
                            window.location.href = "/Home/Index"; 
                        } else {
                            alert("Lỗi: " + response.message);
                            btn.prop("disabled", false).html(originalText);
                        }
                    },
                    error: function () {
                        alert("Đã xảy ra lỗi hệ thống. Vui lòng thử lại sau.");
                        btn.prop("disabled", false).html(originalText);
                    }
                });
            });
        });
    </script>
}