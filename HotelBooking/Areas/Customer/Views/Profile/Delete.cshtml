@{
    ViewBag.Title = "Xóa tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="container-fluid page-header py-5 mb-5" style="background: linear-gradient(rgba(15, 23, 43, 0.7), rgba(15, 23, 43, 0.7)), url('/Content/img/carousel-1.jpg') center/cover;">
    <div class="container py-5">
        <h1 class="display-3 text-white mb-3 animated slideInDown">
            <i class="fa fa-exclamation-triangle me-3"></i>Xóa tài khoản
        </h1>
        <nav aria-label="breadcrumb animated slideInDown">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a class="text-white" href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a class="text-white" href="/Customer/Profile/Index">Hồ sơ</a></li>
                <li class="breadcrumb-item text-white active">Xóa tài khoản</li>
            </ol>
        </nav>
    </div>
</div>

<!-- Delete Account Content -->
<div class="container-xxl py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card border-danger shadow wow fadeInUp" data-wow-delay="0.1s">
                    <div class="card-header bg-danger text-white py-3">
                        <h4 class="mb-0">
                            <i class="fa fa-exclamation-triangle me-2"></i>Xóa tài khoản vĩnh viễn
                        </h4>
                    </div>
                    <div class="card-body p-4">
                        <div class="alert alert-danger border-danger bg-danger bg-opacity-10">
                            <h5 class="fw-bold">
                                <i class="fa fa-exclamation-circle me-2"></i>Cảnh báo quan trọng!
                            </h5>
                            <p class="mb-2">Hành động này <strong>không thể hoàn tác</strong>. Khi xóa tài khoản:</p>
                            <ul class="mb-0">
                                <li>Bạn sẽ mất toàn bộ lịch sử đặt phòng.</li>
                                <li>Điểm tích lũy và hạng thành viên sẽ bị xóa bỏ.</li>
                                <li>Bạn sẽ không thể đăng nhập lại bằng email này.</li>
                            </ul>
                        </div>

                        <p class="mb-3">Nếu bạn chắc chắn muốn tiếp tục, vui lòng nhập mật khẩu xác nhận bên dưới:</p>

                        <form id="deleteAccountForm">
                            <div class="mb-3">
                                <label for="password" class="form-label fw-bold">Mật khẩu của bạn</label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text"><i class="fa fa-lock"></i></span>
                                    <input type="password" class="form-control" id="password" name="password" required placeholder="Nhập mật khẩu để xác nhận">
                                </div>
                            </div>

                            <div class="form-check mb-4 p-3 bg-light rounded">
                                <input class="form-check-input" type="checkbox" id="confirmCheckbox" style="transform: scale(1.2);" required>
                                <label class="form-check-label fw-bold text-danger ms-2" for="confirmCheckbox">
                                    Tôi hiểu hậu quả và đồng ý xóa tài khoản.
                                </label>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-danger btn-lg" id="btnDelete">
                                    <i class="fa fa-trash-alt me-2"></i>Xác nhận xóa tài khoản
                                </button>
                                <a href="/Customer/Profile/Index" class="btn btn-outline-secondary">
                                    <i class="fa fa-arrow-left me-2"></i>Hủy bỏ
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $("#deleteAccountForm").submit(function (e) {
                e.preventDefault();

                // Kiểm tra checkbox
                if (!$("#confirmCheckbox").is(":checked")) {
                    alert("Vui lòng tích vào ô xác nhận đồng ý.");
                    return;
                }

                var password = $("#password").val();
                if (!password) {
                    alert("Vui lòng nhập mật khẩu.");
                    return;
                }

                if (!confirm("CẢNH BÁO CUỐI CÙNG: Bạn có thực sự muốn xóa tài khoản?")) {
                    return;
                }

                var btn = $("#btnDelete");
                var originalText = btn.html();
                btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý...');

                $.ajax({
                    type: "POST",
                    url: '/Customer/Profile/DeleteAccount',
                    data: JSON.stringify({ password: password }),
                    contentType: "application/json; charset=utf-8",
                    success: function (response) {
                        if (response.success) {
                            alert(response.message);
                            // Chuyển hướng về trang chủ sau khi xóa và đăng xuất
                            window.location.href = "/Home/Index";
                        } else {
                            alert("Lỗi: " + response.message);
                            btn.prop("disabled", false).html(originalText);
                        }
                    },
                    error: function () {
                        alert("Đã xảy ra lỗi hệ thống. Vui lòng thử lại sau.");
                        btn.prop("disabled", false).html(originalText);
                    }
                });
            });
        });
    </script>
}