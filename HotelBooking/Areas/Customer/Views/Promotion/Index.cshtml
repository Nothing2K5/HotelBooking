
@{
    ViewBag.Title = "Săn Khuyến Mãi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-primary"><i class="fas fa-gift"></i> Kho Mã Khuyến Mãi</h2>
        <p class="text-muted">Tìm kiếm và áp dụng ngay để tiết kiệm chi phí cho chuyến đi của bạn</p>

        <div class="row justify-content-center mt-4">
            <div class="col-md-6">
                <div class="input-group input-group-lg shadow-sm">
                    <span class="input-group-text bg-white border-end-0"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" id="searchBox" class="form-control border-start-0" placeholder="Nhập mã hoặc tên chương trình...">
                </div>
            </div>
        </div>
    </div>

    <div id="loading" class="text-center my-5">
        <div class="spinner-border text-primary" role="status"></div>
    </div>

    <div class="row g-4" id="promoList">
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            loadPromotions();

            // Tìm kiếm với debounce (đợi người dùng gõ xong mới tìm)
            var timeout = null;
            $("#searchBox").keyup(function () {
                clearTimeout(timeout);
                var query = $(this).val();
                timeout = setTimeout(function () {
                    loadPromotions(query);
                }, 500);
            });
        });

        function loadPromotions(query = "") {
            $("#loading").show();
            $("#promoList").hide();

            $.ajax({
                type: "GET",
                url: '/Customer/Promotion/GetPromotions',
                data: { query: query },
                success: function (response) {
                    $("#loading").hide();
                    $("#promoList").show();

                    if (response.success) {
                        renderPromotions(response.data);
                    } else {
                        $("#promoList").html('<div class="col-12 text-center text-danger">' + response.message + '</div>');
                    }
                },
                error: function () {
                    $("#loading").hide();
                    $("#promoList").html('<div class="col-12 text-center text-danger">Lỗi kết nối máy chủ.</div>');
                }
            });
        }

        function renderPromotions(list) {
            if (!list || list.length === 0) {
                $("#promoList").html(`
                    <div class="col-12 text-center py-5">
                        <i class="fas fa-ticket-alt fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">Không tìm thấy mã khuyến mãi nào phù hợp.</h5>
                    </div>
                `);
                return;
            }

            var html = '';
            list.forEach(function (p) {
                // Format giá trị giảm
                var valueDisplay = "";
                if (p.Type === "percent") {
                    valueDisplay = `<span class="display-4 fw-bold">${p.Value}%</span> <span class="fs-5">OFF</span>`;
                } else {
                    valueDisplay = `<span class="h2 fw-bold">${(p.Value / 1000)}k</span> <span class="fs-5">VNĐ</span>`;
                }

                var endDate = p.EndDate ? new Date(parseInt(p.EndDate.replace(/\/Date\((-?\d+)\)\//, '$1'))).toLocaleDateString('vi-VN') : 'Vô thời hạn';

                html += `
                <div class="col-lg-4 col-md-6">
                    <div class="card h-100 shadow-sm border-0 coupon-card">
                        <div class="card-body d-flex flex-column">
                            <div class="text-center py-3 bg-light rounded-3 mb-3 border border-2 border-dashed">
                                <div class="text-primary">${valueDisplay}</div>
                            </div>

                            <h5 class="card-title fw-bold text-dark">${p.Code}</h5>
                            <p class="card-text text-secondary flex-grow-1">${p.Description || 'Áp dụng cho mọi đơn đặt phòng.'}</p>

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                <small class="text-muted"><i class="far fa-clock"></i> Hạn: ${endDate}</small>
                                <button class="btn btn-outline-primary btn-sm btn-copy" onclick="copyCode('${p.Code}')">
                                    <i class="far fa-copy"></i> Sao chép
                                </button>
                            </div>
                        </div>
                    </div>
                </div>`;
            });

            $("#promoList").html(html);
        }

        function copyCode(code) {
            navigator.clipboard.writeText(code).then(function() {
                // Hiệu ứng thông báo copy thành công (Toast đơn giản)
                var toast = document.createElement("div");
                toast.className = "position-fixed bottom-0 end-0 p-3";
                toast.style.zIndex = "11";
                toast.innerHTML = `
                    <div class="toast show bg-success text-white align-items-center" role="alert" aria-live="assertive" aria-atomic="true">
                        <div class="d-flex">
                            <div class="toast-body">
                                <i class="fas fa-check-circle"></i> Đã sao chép mã: <strong>${code}</strong>
                            </div>
                            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                        </div>
                    </div>
                `;
                document.body.appendChild(toast);

                setTimeout(() => {
                    toast.remove();
                }, 3000);
            }, function(err) {
                alert('Không thể sao chép mã: ' + err);
            });
        }
    </script>

    <style>
        .coupon-card {
            transition: transform 0.2s;
        }

            .coupon-card:hover {
                transform: translateY(-5px);
            }

        .border-dashed {
            border-style: dashed !important;
        }
    </style>
}