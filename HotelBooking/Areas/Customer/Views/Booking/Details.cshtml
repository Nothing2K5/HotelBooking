@model HotelBooking.Models.Booking

@{
    ViewBag.Title = "Chi tiết đặt phòng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<input type="hidden" id="hidden_bookingId" value="@Model.Id" />

<!-- Page Header -->
<div class="container-fluid page-header py-5 mb-5" style="background: linear-gradient(rgba(15, 23, 43, 0.7), rgba(15, 23, 43, 0.7)), url('/Content/img/carousel-1.jpg') center/cover;">
    <div class="container py-5">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb text-white mb-2">
                <li class="breadcrumb-item"><a href="/" class="text-white">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Customer/Booking/Index" class="text-white">Lịch sử</a></li>
                <li class="breadcrumb-item active text-warning">Chi tiết</li>
            </ol>
        </nav>
        <h1 class="display-5 text-white mb-3">Chi tiết đặt phòng</h1>
    </div>
</div>

<!-- Loading State -->
<div id="loading" class="container text-center py-5">
    <div class="spinner-border text-primary" style="width: 3rem; height: 3rem"></div>
    <p class="mt-3">Đang tải thông tin...</p>
</div>

<!-- Main Content -->
<div id="booking_content_area" class="container-xxl py-5" style="display:none;">
    <div class="container">
        <div class="row g-5">
            <!-- Left: Details -->
            <div class="col-lg-8">
                <!-- Booking Code & Status -->
                <div class="card border-0 shadow-sm p-4 mb-4 position-relative">
                    @*<button class="btn btn-outline-primary btn-sm position-absolute top-0 end-0 mt-3 me-3" onclick="window.print()">
                        <i class="fa fa-print me-1"></i>In
                    </button>*@
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h4 class="mb-1" id="bookingCode">Loading...</h4>
                            <p class="text-muted small mb-0">Đặt ngày <span id="bookedDate">--</span></p>
                        </div>
                        <span class="badge fs-6 px-3 py-2" id="statusBadge">Loading</span>
                    </div>
                </div>

                <!-- Hotel Info -->
                <div class="card border-0 shadow-sm p-4 mb-4">
                    <div class="row g-3 align-items-center">
                        <div class="col-md-4">
                            <img id="hotelImage" src="/Content/img/no-image.png" class="img-fluid rounded w-100"
                                 style="height: 190px; object-fit: cover" alt="Hotel" />
                        </div>
                        <div class="col-md-8">
                            <h5 class="mb-1" id="hotelName">Loading...</h5>
                            <p class="text-muted small mb-2">
                                <i class="fa fa-map-marker-alt text-primary me-1"></i>
                                <span id="hotelAddress">...</span>
                            </p>
                            <p class="mb-1"><strong>Phòng <span id="roomType">...</span></strong></p>
                            <p class="mb-0 text-primary fw-bold">
                                <i class="fa fa-calendar-check me-1"></i>
                                <span id="checkinDate">--</span> → <span id="checkoutDate">--</span>
                                (<span id="nightsCount">0</span> đêm)
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Guest & Customer Info -->
                <div class="card border-0 shadow-sm p-4 mb-4">
                    <h5 class="mb-3">
                        <i class="fa fa-user me-2 text-primary"></i>Thông tin khách hàng
                    </h5>
                    <div class="row g-2">
                        <div class="col-md-6"><strong>Tên:</strong> <div id="customerName">-</div></div>
                        <div class="col-md-6"><strong>Email:</strong> <div id="customerEmail">-</div></div>
                        <div class="col-md-6"><strong>Số điện thoại:</strong> <div id="customerPhone">-</div></div>
                        <div class="col-md-6"><strong>Số CMND/Hộ chiếu:</strong> <div id="customerIdNumber">-</div></div>
                        <div class="col-md-6"><strong>Số khách:</strong> <div id="guestsCount">1</div></div>
                        <div class="col-md-6"><strong>Hạng thành viên:</strong> <div id="loyaltyTier">-</div></div>
                    </div>

                    <div id="noteSection" class="mt-3 p-3 bg-light rounded" style="display:none;">
                        <strong><i class="fa fa-sticky-note me-2"></i>Ghi chú:</strong>
                        <span id="noteContent"></span>
                    </div>
                </div>

                <!-- Cancel Reason (if cancelled) -->
                <div id="cancelReasonSection" class="alert alert-danger mt-4" style="display:none;">
                    <strong><i class="fa fa-exclamation-circle me-2"></i>Lý do hủy:</strong>
                    <span id="cancelReason"></span>
                </div>
            </div>

            <!-- Right: Summary & Actions -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm p-4" style="position: -webkit-sticky; position: sticky; top: 100px; z-index: 1020;">
                    <h5 class="mb-3">Tóm tắt thanh toán</h5>

                    <div class="d-flex justify-content-between mb-2">
                        <span>Giá/đêm:</span>
                        <span id="pricePerNight">0 ₫</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Số đêm:</span>
                        <span id="nightsCountSummary">0</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Thành tiền:</span>
                        <span id="subTotal">0 ₫</span>
                    </div>

                    <div id="discountSection" style="display:none" class="d-flex justify-content-between text-success mb-2 small">
                        <span>Giảm giá:</span>
                        <span id="discountAmount">- 0 ₫</span>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between fw-bold fs-5">
                        <span>Tổng cộng:</span>
                        <span class="text-primary" id="totalAmount">0 ₫</span>
                    </div>

                    <div id="penaltySection" class="alert alert-danger mt-3 p-2" style="display:none;">
                        <small class="fw-bold d-block"><i class="fa fa-exclamation-circle"></i>Phí hủy:</small>
                        <div class="d-flex justify-content-between">
                            <span>Phạt:</span>
                            <span id="penaltyAmount" class="fw-bold">0 ₫</span>
                        </div>
                    </div>
                    <div class="mt-3 p-3 bg-light rounded small">
                        <i class="fa fa-info-circle text-primary me-1"></i>
                        Hạn hủy miễn phí: <strong id="freeCancelDate" class="text-dark">--</strong>
                    </div>
                </div>

                <div class="mt-4" id="actionButtons" style="position: -webkit-sticky; position: sticky; top: 480px; z-index: 1020;"></div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        var bookingId = $("#hidden_bookingId").val();

        $(document).ready(function () {
            loadBookingDetails();
        });

        function loadBookingDetails() {
            $.ajax({
                type: "GET",
                url: '/Customer/Booking/GetBookingInfo',
                data: { id: bookingId },
                success: function (response) {
                    $("#loading").hide();
                    if (response.success) {
                        renderData(response.data);
                        $("#booking_content_area").fadeIn();
                    } else {
                        $("#booking_content_area").html('<div class="alert alert-danger m-3">' + response.message + '</div>').fadeIn();
                    }
                },
                error: function () {
                    $("#loading").hide();
                    alert("Không thể tải thông tin booking.");
                }
            });
        }

        function renderData(data) {
            // Basic info
            $("#bookingCode").text(data.Code);
            $("#hotelName").text(data.HotelName);
            $("#hotelAddress").text(data.HotelAddress);
            $("#checkinDate").text(formatDate(data.CheckInDate));
            $("#checkoutDate").text(formatDate(data.CheckOutDate));
            $("#guestsCount").text(data.Guests);
            $("#bookedDate").text(formatDateTime(data.CreatedAt || data.CheckInDate));

            // Hotel image (fallback handled in onerror)
            if (data.HotelImageUrl) {
                $("#hotelImage").attr('src', data.HotelImageUrl).on('error', function () { $(this).attr('src', '/Content/img/no-image.png'); });
            }

            // Status badge
            $("#statusBadge").html(getStatusBadge(data.Status));

            // Room info and pricing breakdown
            if (data.RoomInfo) {
                var room = data.RoomInfo;
                $("#roomType").text(room.RoomType || room.RoomNumber || '-');
                $("#nightsCount").text(room.Nights || 0);
                $("#nightsCountSummary").text(room.Nights || 0);
                $("#pricePerNight").text(formatCurrency(room.Price));
                $("#subTotal").text(formatCurrency(room.SubTotal));
            }

            // Pricing
            var totalStr = formatCurrency(data.TotalAmount);
            $("#totalAmount").text(totalStr);

            $("#freeCancelDate").text(formatDateTime(data.FreeCancellationDeadline));

            // Discount (if any). Expect data.DiscountAmount from server (nullable)
            if (data.DiscountAmount && data.DiscountAmount > 0) {
                $("#discountAmount").text('- ' + formatCurrency(data.DiscountAmount));
                $("#discountSection").show();
            }

            // Note
            if (data.Note) {
                $("#noteContent").text(data.Note);
                $("#noteSection").show();
            }

            // Penalty
            if (data.PenaltyAmount && data.PenaltyAmount > 0) {
                $("#penaltyAmount").text(formatCurrency(data.PenaltyAmount));
                $("#penaltySection").show();
            }

            // Customer info (from server)
            if (data.Customer) {
                $("#customerName").text(data.Customer.FullName || '-');
                $("#customerEmail").text(data.Customer.Email || '-');
                $("#customerPhone").text(data.Customer.Phone || '-');
                $("#customerIdNumber").text(data.Customer.IdNumber || '-');
                $("#loyaltyTier").text(data.Customer.LoyaltyTierName || '-');
            }

            // Cancel reason
            if (data.Status === 'cancelled' && data.Note && data.Note.indexOf('Lý do') > -1) {
                $("#cancelReason").text(data.Note);
                $("#cancelReasonSection").show();
            }

            // Action buttons
            renderActions(data);
        }

        function renderActions(data) {
            var html = '';
            var now = new Date();
            var checkOutDate = parseJsonDate(data.CheckOutDate);
            var freeCancelDeadline = parseJsonDate(data.FreeCancellationDeadline);
            var isCompleted = (now > checkOutDate) && (data.Status === 'paid' || data.Status === 'confirmed');

            html += '<a href="/Customer/Booking/Index" class="btn btn-outline-secondary w-100 mb-2"><i class="fa fa-arrow-left me-1"></i>Quay lại lịch sử</a>';

            html += '<button class="btn btn-primary w-100 mb-2" onclick="window.print()"><i class="fa fa-print me-1"></i>In xác nhận</button>';

            if (data.Status === "draft" || data.Status === "pending") {
                html += '<a href="/Customer/Booking/Payment/' + data.Id + '" class="btn btn-success w-100 mb-2"><i class="fa fa-credit-card me-1"></i>Thanh toán ngay</a>';
            }

            if (isCompleted) {
                html += '<a href="/Customer/Review/Create?bookingId=' + data.Id + '" class="btn btn-warning w-100 fw-bold shadow-sm mb-2"><i class="fa fa-star me-2"></i>Viết đánh giá (Nhận 50 điểm!)</a>';
            }

            // Cho phép hủy khi: chưa hủy và chưa hoàn thành AND (chưa thanh toán OR thanh toán nhưng còn trong hạn hủy miễn phí)
            var allowCancel = (data.Status !== 'cancelled' && !isCompleted) && (data.Status !== 'paid' || (data.Status === 'paid' && now < freeCancelDeadline));
            if (allowCancel) {
                html += '<button class="btn btn-outline-danger w-100" onclick="confirmCancel(' + data.Id + ')"><i class="fa fa-times me-1"></i>Hủy đặt phòng</button>';
            }

            $("#actionButtons").html(html);
        }

        function confirmCancel(id) {
            window.location.href = '/Customer/Booking/Cancel/' + id;
        }

        function getStatusBadge(status) {
            var badges = {
                "draft": '<span class="badge bg-secondary">Bản nháp</span>',
                "pending": '<span class="badge bg-warning text-dark">Chờ thanh toán</span>',
                "paid": '<span class="badge bg-success">Đã thanh toán</span>',
                "confirmed": '<span class="badge bg-info">Đã xác nhận</span>',
                "cancelled": '<span class="badge bg-danger">Đã hủy</span>',
                "completed": '<span class="badge bg-primary">Hoàn thành</span>'
            };
            return badges[status] || '<span class="badge bg-secondary">' + status + '</span>';
        }

        function formatCurrency(val) {
            if (val === null || val === undefined) return "0 ₫";
            return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(val);
        }

        function parseJsonDate(jsonDate) {
            if (!jsonDate) return new Date();
            if (typeof jsonDate === 'string' && jsonDate.indexOf("/Date(") !== -1) {
                return new Date(parseInt(jsonDate.replace(/\/Date\((-?\d+)\)\//, '$1')));
            }
            return new Date(jsonDate);
        }

        function formatDate(jsonDate) {
            var date = parseJsonDate(jsonDate);
            return date.toLocaleDateString('vi-VN');
        }

        function formatDateTime(jsonDate) {
            var date = parseJsonDate(jsonDate);
            return date.toLocaleString('vi-VN');
        }
    </script>
}
