@{
    ViewBag.Title = "Đặt phòng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page Header -->
<div class="container-fluid page-header py-5 mb-5" style="background: linear-gradient(rgba(15, 23, 43, 0.7), rgba(15, 23, 43, 0.7)), url('/Content/img/carousel-1.jpg') center/cover;">
    <div class="container py-5">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb text-white mb-2">
                <li class="breadcrumb-item"><a href="/" class="text-white">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Search/Index" class="text-white">Tìm kiếm</a></li>
                <li class="breadcrumb-item active text-warning">Đặt phòng</li>
            </ol>
        </nav>
        <h1 class="display-5 text-white mb-3">Xác nhận đặt phòng</h1>
    </div>
</div>

<!-- Main Content -->
<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-5">
            <!-- Form Area -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm p-4 mb-4 wow fadeInUp" data-wow-delay="0.1s">
                    <h5 class="mb-4"><i class="fa fa-calendar-check me-2 text-primary"></i>Thông tin đặt phòng</h5>

                    <form id="bookingForm">
                        <input type="hidden" id="hotelId" value="@ViewBag.HotelId" />
                        <input type="hidden" id="roomId" value="@ViewBag.RoomId" />

                        <div id="error-message" class="alert alert-danger" style="display:none;"></div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label for="checkInDate" class="form-label fw-bold">Ngày nhận phòng</label>
                                <input type="date" class="form-control form-control-lg" id="checkInDate" required />
                            </div>
                            <div class="col-md-6">
                                <label for="checkOutDate" class="form-label fw-bold">Ngày trả phòng</label>
                                <input type="date" class="form-control form-control-lg" id="checkOutDate" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="guests" class="form-label fw-bold">Số khách (Tối đa <span id="maxCapacity">2</span>)</label>
                            <input type="number" class="form-control form-control-lg" id="guests" value="1" min="1" required />
                        </div>

                        <div class="mb-3">
                            <label for="promoCode" class="form-label fw-bold">Mã khuyến mãi (nếu có)</label>
                            <div class="input-group input-group-lg">
                                <input type="text" class="form-control" id="promoCode" placeholder="Nhập mã giảm giá..." />
                                <button class="btn btn-outline-primary" type="button" id="btnApplyPromo">Áp dụng</button>
                            </div>
                            <small id="promoMessage" class="mt-1" style="display:none;"></small>
                        </div>

                        <div class="mb-4">
                            <label for="note" class="form-label fw-bold">Yêu cầu đặc biệt</label>
                            <textarea class="form-control" id="note" rows="3" placeholder="Ví dụ: Nhận phòng trễ, giường đôi..."></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold">
                            Tiếp tục thanh toán <i class="fa fa-arrow-right ms-2"></i>
                        </button>
                    </form>
                </div>
            </div>

            <!-- Summary Sidebar -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm p-4 sticky-top wow fadeInUp" data-wow-delay="0.2s" style="top: 100px">
                    <h5 class="mb-3"><i class="fa fa-hotel text-primary me-2"></i>Tóm tắt chi phí</h5>
                    <div id="bookingSummary">
                        <div class="text-center py-3">
                            <div class="spinner-border text-primary" role="status"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        var roomId = parseInt($("#roomId").val());
        var hotelId = parseInt($("#hotelId").val());
        var roomPrice = 0;
        var discountAmount = 0;
        var appliedPromoCode = "";

        $(document).ready(function () {
            var today = new Date().toISOString().split('T')[0];
            $("#checkInDate").attr('min', today).val(today);

            var tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            var tomorrowStr = tomorrow.toISOString().split('T')[0];
            $("#checkOutDate").attr('min', tomorrowStr).val(tomorrowStr);

            loadRoomInfo();

            $("#checkInDate, #checkOutDate").change(function () {
                if (this.id === 'checkInDate') {
                    $("#checkOutDate").attr('min', $(this).val());
                }
                resetPromo();
                updateSummary();
            });

            $("#btnApplyPromo").click(function () {
                applyPromoCode();
            });

            $("#bookingForm").submit(function (e) {
                e.preventDefault();
                createBooking();
            });
        });

        function resetPromo() {
            discountAmount = 0;
            appliedPromoCode = "";
            $("#promoCode").val('');
            $("#promoMessage").hide().removeClass('text-success text-danger');
        }

        function loadRoomInfo() {
            $.ajax({
                type: "GET",
                url: '/Customer/Booking/GetRoomInfo',
                data: { roomId: roomId, hotelId: hotelId },
                success: function (response) {
                    if (response.success) {
                        roomPrice = response.room.PricePerNight;
                        $("#guests").attr('max', response.room.Capacity);
                        $("#maxCapacity").text(response.room.Capacity);

                        var typeLabel = response.room.Type === 'VIP' ? 'VIP' : 'Thường';

                        var html = `
                                        <h6 class="text-primary fw-bold">${response.hotel.Name}</h6>
                                        <hr/>
                                        <p class="mb-1"><strong>Phòng:</strong> ${response.room.RoomNumber}</p>
                                        <p class="mb-1"><strong>Loại:</strong> ${typeLabel}</p>
                                        <p class="mb-3"><strong>Giá:</strong> ${roomPrice.toLocaleString()} ₫/đêm</p>
                                        <div id="priceCalculation"></div>
                                    `;
                        $("#bookingSummary").html(html);
                        updateSummary();
                    } else {
                        alert(response.message);
                        window.history.back();
                    }
                }
            });
        }

        function updateSummary() {
            var checkIn = new Date($("#checkInDate").val());
            var checkOut = new Date($("#checkOutDate").val());

            if (checkOut <= checkIn) {
                $("#priceCalculation").html('<p class="text-danger small">Ngày trả phòng phải sau ngày nhận phòng</p>');
                return;
            }

            var timeDiff = checkOut - checkIn;
            var nights = Math.ceil(timeDiff / (1000 * 3600 * 24));

            if (nights > 0 && roomPrice > 0) {
                var subtotal = roomPrice * nights;
                var total = subtotal - discountAmount;
                if (total < 0) total = 0;

                var html = `
                                <div class="bg-light p-3 rounded">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Số đêm:</span>
                                        <strong>${nights}</strong>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Tạm tính:</span>
                                        <span>${subtotal.toLocaleString()} ₫</span>
                                    </div>`;

                if (discountAmount > 0) {
                    html += `
                                    <div class="d-flex justify-content-between mb-2 text-success">
                                        <span>Giảm giá:</span>
                                        <span>-${discountAmount.toLocaleString()} ₫</span>
                                    </div>`;
                }

                html += `
                                    <hr class="my-2"/>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fw-bold">Tổng cộng:</span>
                                        <span class="text-danger fw-bold h5 mb-0">${total.toLocaleString()} ₫</span>
                                    </div>
                                </div>`;
                $("#priceCalculation").html(html);
            }
        }

        function applyPromoCode() {
            var code = $("#promoCode").val().trim();
            if (!code) {
                alert("Vui lòng nhập mã.");
                return;
            }

            var checkIn = new Date($("#checkInDate").val());
            var checkOut = new Date($("#checkOutDate").val());
            var nights = Math.ceil((checkOut - checkIn) / (1000 * 3600 * 24));
            var subtotal = roomPrice * nights;

            if (nights <= 0) {
                alert("Vui lòng chọn ngày hợp lệ trước.");
                return;
            }

            $.ajax({
                type: "POST",
                url: '/Customer/Booking/ValidatePromo',
                data: JSON.stringify({ code: code }),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    if (response.success) {
                        var promo = response.promo;

                        if (promo.Type === 'percent') {
                            discountAmount = subtotal * (promo.Value / 100);
                        } else {
                            discountAmount = promo.Value;
                        }

                        if (discountAmount > subtotal) discountAmount = subtotal;

                        appliedPromoCode = promo.Code;

                        $("#promoMessage")
                            .text(`Áp dụng thành công! Giảm ${discountAmount.toLocaleString()} ₫`)
                            .removeClass('text-danger').addClass('text-success').show();

                        updateSummary();
                    } else {
                        discountAmount = 0;
                        appliedPromoCode = "";
                        $("#promoMessage")
                            .text(response.message)
                            .removeClass('text-success').addClass('text-danger').show();
                        updateSummary();
                    }
                },
                error: function () {
                    alert("Lỗi khi kiểm tra mã.");
                }
            });
        }

        function createBooking() {
            var guests = parseInt($("#guests").val());
            var maxGuests = parseInt($("#guests").attr('max'));

            if (guests > maxGuests) {
                $("#error-message").text(`Phòng này chỉ chứa tối đa ${maxGuests} người.`).show();
                return;
            }

            var formData = {
                HotelId: hotelId,
                RoomId: roomId,
                CheckInDate: $("#checkInDate").val(),
                CheckOutDate: $("#checkOutDate").val(),
                Guests: guests,
                Note: $("#note").val(),
                PromoCode: appliedPromoCode
            };

            var btn = $("button[type=submit]");
            var originalText = btn.html();
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Đang xử lý...');

            $.ajax({
                type: "POST",
                url: '/Customer/Booking/CreateBooking',
                data: JSON.stringify(formData),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    if (response.success) {
                        window.location.href = '/Customer/Booking/Payment/' + response.bookingId;
                    } else {
                        $("#error-message").text(response.message).show();
                        btn.prop('disabled', false).html(originalText);
                    }
                },
                error: function () {
                    $("#error-message").text("Đã xảy ra lỗi. Vui lòng thử lại.").show();
                    btn.prop('disabled', false).html(originalText);
                }
            });
        }
    </script>
}