@{
    ViewBag.Title = "Chỉnh sửa đánh giá";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid page-header py-5 mb-5" style="background: linear-gradient(rgba(15, 23, 43, 0.7), rgba(15, 23, 43, 0.7)), url('/Content/img/carousel-1.jpg') center/cover;">
    <div class="container py-5">
        <h1 class="display-3 text-white mb-3 animated slideInDown">Sửa đánh giá</h1>
        <nav aria-label="breadcrumb animated slideInDown">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a class="text-white" href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a class="text-white" href="/Customer/Review/Index">Đánh giá của tôi</a></li>
                <li class="breadcrumb-item text-white active">Sửa đánh giá</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container-xxl py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm overflow-hidden wow fadeInUp" style="border-radius: 24px" data-wow-delay="0.1s">
                    <div class="position-relative">
                        <img id="hotelImg" src="/Content/images/hotel-placeholder.jpg" onerror="this.src='/Content/images/hotel-placeholder.jpg'" class="w-100" style="height: 280px; object-fit: cover" alt="" />
                        <div class="position-absolute bottom-0 start-0 end-0 p-5 text-white text-center" style="background: linear-gradient(0deg, rgba(0, 0, 0, 0.8) 0%, transparent 100%);">
                            <h3 id="hotelName" class="fw-bold mb-2">Đang tải...</h3>
                            <p id="reviewMeta" class="fs-5 mb-0"></p>
                        </div>
                    </div>

                    <div class="card-body p-5">
                        <form id="editReviewForm">
                            <input type="hidden" id="reviewId" value="@ViewBag.ReviewId" />
                            <input type="hidden" id="ratingValue" name="Rating" />

                            <div class="text-center mb-5">
                                <label class="form-label fw-bold fs-5 mb-4">Đánh giá tổng thể <span class="text-danger">*</span></label>
                                <div class="d-inline-flex gap-3 star-big" id="overallRating" style="cursor: pointer;">
                                    <i class="fa fa-star fs-1" data-value="1"></i>
                                    <i class="fa fa-star fs-1" data-value="2"></i>
                                    <i class="fa fa-star fs-1" data-value="3"></i>
                                    <i class="fa fa-star fs-1" data-value="4"></i>
                                    <i class="fa fa-star fs-1" data-value="5"></i>
                                </div>
                                <div id="ratingText" class="mt-3 h5 text-primary fw-bold">...</div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-bold">Tiêu đề đánh giá</label>
                                <input type="text" id="reviewTitle" class="form-control form-control-lg rounded-3" required />
                            </div>

                            <div class="mb-5">
                                <label class="form-label fw-bold">Nội dung đánh giá <span class="text-danger">*</span></label>
                                <textarea id="reviewContent" class="form-control rounded-3" rows="7" required></textarea>
                            </div>

                            <div class="text-end">
                                <a href="/Customer/Review/Index" class="btn btn-outline-secondary btn-lg px-5 me-3 rounded-pill">Hủy bỏ</a>
                                <button type="submit" class="btn btn-success btn-lg px-5 rounded-pill shadow-sm fw-bold">
                                    <i class="fa fa-save me-2"></i>Lưu thay đổi
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        var reviewId = $("#reviewId").val();
        $(document).ready(function () {
            loadReviewData();

            // Logic chọn sao
            $("#overallRating i").hover(function () {
                var val = $(this).data("value");
                highlightStars(val);
                updateRatingText(val);
            }, function () {
                var val = $("#ratingValue").val();
                highlightStars(val);
                updateRatingText(val);
            });

            $("#overallRating i").click(function () {
                var val = $(this).data("value");
                $("#ratingValue").val(val);
                highlightStars(val);
                updateRatingText(val);
            });

            $("#editReviewForm").submit(function (e) {
                e.preventDefault();
                updateReview();
            });
        });

        function loadReviewData() {
            $.ajax({
                type: "GET",
                url: '/Customer/Review/GetReviewById',
                data: { id: reviewId },
                success: function (response) {
                    if (response.success) {
                        var r = response.data;

                        // Fill Data
                        $("#hotelName").text(r.HotelName);
                        $("#reviewMeta").html(`<i class="fa fa-clock me-2"></i>Đã đăng: ${formatDate(r.CreatedAt)}`);

                        if (r.HotelImage) {
                            $("#hotelImg").attr("src", r.HotelImage);
                        }

                        $("#ratingValue").val(r.Rating);
                        $("#reviewTitle").val(r.Title);
                        $("#reviewContent").val(r.Content);

                        // Cập nhật giao diện sao
                        highlightStars(r.Rating);
                        updateRatingText(r.Rating);
                    } else {
                        alert(response.message);
                        window.location.href = "/Customer/Review/Index";
                    }
                }
            });
        }

        function updateReview() {
            var data = {
                Id: reviewId,
                Rating: $("#ratingValue").val(),
                Title: $("#reviewTitle").val(),
                Content: $("#reviewContent").val()
            };

            var btn = $("button[type=submit]");
            var originalText = btn.html();
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Đang cập nhật...');

            $.ajax({
                type: "POST",
                url: '/Customer/Review/UpdateReview',
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                        window.location.href = "/Customer/Review/Index";
                    } else {
                        alert("Lỗi: " + response.message);
                        btn.prop('disabled', false).html(originalText);
                    }
                },
                error: function () {
                    alert("Đã xảy ra lỗi khi cập nhật.");
                    btn.prop('disabled', false).html(originalText);
                }
            });
        }

        function highlightStars(count) {
            $("#overallRating i").each(function (index) {
                if (index < count) {
                    $(this).removeClass("far").addClass("fas").css("color", "#ffc107");
                } else {
                    $(this).removeClass("fas").addClass("far").css("color", "#ddd");
                }
            });
        }

        function updateRatingText(val) {
            var texts = ["Rất tệ", "Tệ", "Bình thường", "Tốt", "Tuyệt vời"];
            if (val >= 1 && val <= 5) {
                $("#ratingText").text(texts[val - 1] + " (" + val + "/5)");
            }
        }

        function formatDate(jsonDate) {
            if (!jsonDate) return "";
            var timestamp = parseInt(jsonDate.replace(/\/Date\((-?\d+)\)\//, '$1'));
            if (isNaN(timestamp)) return jsonDate;
            var date = new Date(timestamp);
            return date.toLocaleDateString('vi-VN');
        }
    </script>
}