@{
    ViewBag.Title = "Đánh giá của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid page-header py-5 mb-5" style="background: linear-gradient(rgba(15, 23, 43, 0.7), rgba(15, 23, 43, 0.7)), url('/Content/img/carousel-1.jpg') center/cover;">
    <div class="container py-5">
        <h1 class="display-3 text-white mb-3 animated slideInDown">Đánh giá của tôi</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a class="text-white" href="/">Trang chủ</a></li>
                <li class="breadcrumb-item text-white active">Đánh giá</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container-xxl py-5">
    <div class="container">
        <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
            <h6 class="section-title text-center text-primary px-3">Lịch sử đánh giá</h6>
            <h1 class="mb-5">Chia sẻ trải nghiệm của bạn</h1>
        </div>

        <div id="loading" class="text-center my-5"><div class="spinner-border text-primary"></div></div>

        <div class="row g-4" id="reviewsList" style="display:none;">
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            loadMyReviews();
        });

        function loadMyReviews() {
            $.ajax({
                type: "GET",
                url: '/Customer/Review/GetMyReviews',
                success: function (response) {
                    $("#loading").hide();
                    $("#reviewsList").fadeIn();

                    if (response.success) {
                        displayReviews(response.data);
                    } else {
                        $("#reviewsList").html('<div class="col-12"><div class="alert alert-danger">' + response.message + '</div></div>');
                    }
                },
                error: function () {
                    $("#loading").hide();
                    $("#reviewsList").html('<div class="col-12"><div class="alert alert-danger">Lỗi kết nối.</div></div>');
                }
            });
        }

        function displayReviews(reviews) {
            if (!reviews || reviews.length === 0) {
                $("#reviewsList").html(`
                            <div class="col-12 text-center py-5">
                                <div class="bg-light rounded p-5 d-inline-block">
                                    <i class="far fa-comment-dots fa-4x text-muted mb-3"></i>
                                    <h5>Bạn chưa có đánh giá nào</h5>
                                    <p class="text-muted mb-4">Hãy đặt phòng và chia sẻ trải nghiệm để nhận điểm thưởng!</p>
                                    <a href="/Search/Index" class="btn btn-primary px-4">Đặt phòng ngay</a>
                                </div>
                            </div>
                        `);
                return;
            }

            var html = '';
            reviews.forEach(function (r) {
                // Render Stars
                var stars = '';
                for (var i = 1; i <= 5; i++) {
                    stars += (i <= r.Rating) ? '<small class="fa fa-star text-warning"></small>' : '<small class="far fa-star text-warning"></small>';
                }

                var date = new Date(parseInt(r.CreatedAt.replace(/\/Date\((-?\d+)\)\//, '$1'))).toLocaleDateString('vi-VN');

                // Action Buttons
                var actions = '';
                if (r.CanEdit) {
                    actions = `
                                <div class="mt-3 pt-3 border-top d-flex gap-2">
                                    <a href="/Customer/Review/Edit/${r.Id}" class="btn btn-sm btn-outline-primary flex-fill"><i class="fa fa-edit me-1"></i> Sửa</a>
                                    <button class="btn btn-sm btn-outline-danger flex-fill" onclick="deleteReview(${r.Id})"><i class="fa fa-trash me-1"></i> Xóa</button>
                                </div>`;
                } else {
                    actions = `<div class="mt-3 pt-3 border-top text-center"><small class="text-muted"><i class="fa fa-lock me-1"></i> Đã chốt (Quá hạn sửa)</small></div>`;
                }

                html += `
                        <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body p-4 d-flex flex-column">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="flex-shrink-0 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                                            <i class="fa fa-hotel"></i>
                                        </div>
                                        <div class="ms-3 overflow-hidden">
                                            <h6 class="mb-0 text-truncate">${r.HotelName}</h6>
                                            <small class="text-muted">${date}</small>
                                        </div>
                                    </div>

                                    <div class="mb-2">${stars}</div>
                                    <h6 class="fw-bold mb-2">${r.Title || 'Không có tiêu đề'}</h6>
                                    <p class="text-muted small mb-3 flex-grow-1 text-truncate-3">${r.Content || 'Không có nội dung.'}</p>

                                    ${actions}
                                </div>
                            </div>
                        </div>`;
            });
            $("#reviewsList").html(html);
        }

        function deleteReview(id) {
            if (!confirm("Bạn có chắc muốn xóa đánh giá này?")) return;
            $.ajax({
                type: "POST", url: '/Customer/Review/DeleteReview',
                data: JSON.stringify({ id: id }), contentType: "application/json",
                success: function (res) {
                    if (res.success) loadMyReviews();
                    else alert(res.message);
                }
            });
        }
    </script>
    <style>
        .text-truncate-3 {
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>
}