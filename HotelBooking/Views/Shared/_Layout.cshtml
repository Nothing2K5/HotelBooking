<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - ABC Hotel</title>

    <!-- Favicon -->
    <link href="~/Content/img/favicon.ico" rel="icon" />

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet" />

    <!-- Flatpickr CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />

    <!-- Libraries Stylesheet -->
    <link href="~/Content/lib/animate/animate.min.css" rel="stylesheet" />
    <link href="~/Content/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet" />

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Template Stylesheet -->
    <link href="~/Content/css/style.css" rel="stylesheet" />

    <style>
        body {
            font-family: 'Heebo', sans-serif;
            padding-top: 0;
        }

        /* Custom Header */
        .custom-header {
            background: linear-gradient(135deg, #0F172B 0%, #1E3A8A 100%);
            padding: 1rem 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo-text {
            color: #fff !important;
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            text-decoration: none;
        }

            .logo-text span {
                color: #FEA116;
            }

        .custom-header .nav-link {
            color: rgba(255, 255, 255, 0.8) !important;
            padding: 0.5rem 1rem;
            transition: all 0.3s;
            font-weight: 500;
        }

            .custom-header .nav-link:hover,
            .custom-header .nav-link.active {
                color: #FEA116 !important;
            }

        /* User Menu */
        .user-menu .avatar-circle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, #FEA116 0%, #FF6B6B 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 1.1rem;
        }

        .user-info .user-name {
            font-weight: 600;
            font-size: 0.95rem;
        }

        .user-info .user-rank {
            font-size: 0.75rem;
        }

        .dropdown-arrow {
            transition: transform 0.3s;
        }

        .user-menu .dropdown-toggle:hover .dropdown-arrow {
            transform: rotate(180deg);
        }

        /* Colorful Dropdown */
        .colorful-dropdown {
            min-width: 250px;
            padding: 0.5rem 0;
        }

        .colorful-item {
            padding: 0.75rem 1.25rem;
            transition: all 0.3s;
        }

            .colorful-item:hover {
                background: linear-gradient(90deg, #f8f9fa 0%, #e9ecef 100%);
                transform: translateX(5px);
            }

        /* Guest Header Buttons */
        .btn-outline-light {
            border: 2px solid rgba(255, 255, 255, 0.5);
            color: #fff;
            font-weight: 500;
            transition: all 0.3s;
        }

            .btn-outline-light:hover {
                background: #fff;
                color: #0F172B;
                border-color: #fff;
            }

        .btn-light {
            background: #FEA116;
            border: 2px solid #FEA116;
            color: #fff;
            font-weight: 600;
            transition: all 0.3s;
        }

            .btn-light:hover {
                background: #fff;
                color: #FEA116;
                border-color: #fff;
            }

        /* Back to Top */
        .back-to-top {
            position: fixed;
            bottom: 30px;
            right: 30px;
            display: none;
            z-index: 99;
            background: #FEA116;
            color: #fff;
            border: none;
        }

            .back-to-top:hover {
                background: #0F172B;
            }

        /* Spinner */
        #spinner {
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s ease-out, visibility 0s linear 0.3s;
            z-index: 99999;
        }

            #spinner.show {
                transition: opacity 0.3s ease-out, visibility 0s linear 0s;
                visibility: visible;
                opacity: 1;
            }
    </style>
</head>
<body>
    <div class="container-fluid p-0">
        <!-- Spinner Start -->
        <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
        <!-- Spinner End -->
        <!-- ===== Header Start ===== -->
        <header class="custom-header shadow-sm">
            <div class="container-fluid px-5 d-flex align-items-center justify-content-between">
                <!-- Logo -->
                <a href="/" class="navbar-brand fw-bold fs-3 text-white logo-text">
                    ABC <span>HOTEL</span>
                </a>

                <!-- Navigation -->
                <nav class="d-none d-lg-flex">
                    <ul class="nav mb-0">
                        <li class="nav-item">
                            <a href="/" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a href="/Search/Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Search" ? "active" : "")">Đặt phòng</a>
                        </li>
                        @if (Request.IsAuthenticated && User.IsInRole("customer"))
                        {
                            <li class="nav-item">
                                <a href="/Customer/Promotion/Index" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Promotion" ? "active" : "")">Ưu đãi</a>
                            </li>
                        }
                    </ul>
                </nav>

                @if (Request.IsAuthenticated)
                {
                    <!-- User Dropdown (Logged In) -->
                    <div class="dropdown user-menu">
                        <a href="#" class="d-flex align-items-center text-white text-decoration-none" id="userDropdown" data-bs-toggle="dropdown">
                            <div class="avatar-circle me-2">@User.Identity.Name.Substring(0, 1).ToUpper()</div>
                            <div class="user-info text-start d-none d-md-block">
                                <div class="user-name">@User.Identity.Name</div>
                                @if (User.IsInRole("customer"))
                                {
                                    <small class="user-rank text-light opacity-75">Thành viên</small>
                                }
                            </div>
                            <i class="fa fa-chevron-down ms-2 text-light small dropdown-arrow"></i>
                        </a>

                        <!-- Dropdown Menu -->
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 colorful-dropdown" aria-labelledby="userDropdown">
                            @if (User.IsInRole("customer"))
                            {
                                <li>
                                    <a class="dropdown-item colorful-item" href="/Customer/Profile/Index">
                                        <i class="fa fa-user me-2 text-primary"></i>Thông tin cá nhân
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item colorful-item" href="/Customer/Booking/Index">
                                        <i class="fa fa-calendar me-2 text-success"></i>Lịch sử Booking
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item colorful-item" href="/Customer/Review/Index">
                                        <i class="fa fa-star me-2 text-warning"></i>Đánh giá của tôi
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item colorful-item" href="/Customer/Loyalty/Index">
                                        <i class="fa fa-trophy me-2 text-info"></i>Xem hạng thành viên
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                            }

                            @if (User.IsInRole("admin"))
                            {
                                <li>
                                    <a class="dropdown-item colorful-item" href="/Admin/Hotel/Index">
                                        <i class="fa fa-cog me-2 text-primary"></i>Quản trị Admin
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                            }

                            <li>
                                <a class="dropdown-item colorful-item text-danger" href="#" onclick="logout(); return false;">
                                    <i class="fa fa-sign-out-alt me-2 text-danger"></i>Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <!-- Guest Buttons (Not Logged In) -->
                    <div class="d-flex align-items-center">
                        <a href="/Account/Login" class="btn btn-outline-light me-2">Đăng nhập</a>
                        <a href="/Account/Register" class="btn btn-light">Đăng ký</a>
                    </div>
                }
            </div>
        </header>
        <!-- ===== Header End ===== -->
        <!-- Main Content -->
        <div class="content-wrapper">
            @RenderBody()
        </div>

        <!-- Back to Top -->
        <a href="#" class="btn btn-lg btn-primary btn-lg-square back-to-top">
            <i class="bi bi-arrow-up"></i>
        </a>
    </div>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Bootstrap 5 Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Flatpickr -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <!-- WOW.js -->
    <script src="~/Content/lib/wow/wow.min.js"></script>
    <script src="~/Content/lib/easing/easing.min.js"></script>
    <script src="~/Content/lib/waypoints/waypoints.min.js"></script>
    <script src="~/Content/lib/counterup/counterup.min.js"></script>
    <script src="~/Content/lib/owlcarousel/owl.carousel.min.js"></script>

    <script>
        // Spinner
        $(window).on('load', function () {
            $('#spinner').removeClass('show');
        });

        // Back to top button
        $(window).scroll(function () {
            if ($(this).scrollTop() > 300) {
                $('.back-to-top').fadeIn('slow');
            } else {
                $('.back-to-top').fadeOut('slow');
            }
        });

        $('.back-to-top').click(function (e) {
            e.preventDefault();
            $('html, body').animate({ scrollTop: 0 }, 1000, 'easeInOutExpo');
            return false;
        });

        // Logout function
        function logout() {
            if (confirm("Bạn có chắc chắn muốn đăng xuất?")) {
                $.ajax({
                    type: "POST",
                    url: window.location.origin + '/Account/Logout',
                    success: function () {
                        window.location.href = '/';
                    },
                    error: function () {
                        alert("Đã xảy ra lỗi khi đăng xuất!");
                    }
                });
            }
        }

        // WOW.js initialization
        if (typeof WOW !== 'undefined') {
            new WOW().init();
        }
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>