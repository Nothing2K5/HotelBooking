@{
    ViewBag.Title = "Quên mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-header bg-primary text-white text-center">
                <h4 class="mb-0">Quên mật khẩu</h4>
            </div>
            <div class="card-body p-4">
                <p class="text-muted text-center mb-4">Nhập email đã đăng ký để lấy lại mật khẩu.</p>

                <form id="forgotPasswordForm">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Email</label>
                        <input type="email" id="email" class="form-control" placeholder="example@mail.com" required />
                    </div>

                    <div id="alertMessage" class="alert" style="display:none;"></div>

                    <button type="submit" class="btn btn-primary w-100 btn-lg" id="btnSubmit">
                        Gửi yêu cầu
                    </button>
                </form>

                <div class="text-center mt-3">
                    <a href="@Url.Action("Login", "Account")" class="text-decoration-none">
                        <i class="fas fa-arrow-left"></i> Quay lại Đăng nhập
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $("#forgotPasswordForm").submit(function (e) {
                e.preventDefault();

                var email = $("#email").val().trim();
                var btn = $("#btnSubmit");
                var originalText = btn.html();

                // Reset thông báo
                $("#alertMessage").hide().removeClass("alert-success alert-danger");
                btn.prop("disabled", true).html('<span class="spinner-border spinner-border-sm"></span> Đang xử lý...');

                $.ajax({
                    type: "POST",
                    url: '/Account/ForgotPassword',
                    data: JSON.stringify({ email: email }),
                    contentType: "application/json; charset=utf-8",
                    success: function (response) {
                        btn.prop("disabled", false).html(originalText);

                        if (response.success) {
                            // Hiển thị mật khẩu mới (Mô phỏng gửi mail thành công)
                            $("#alertMessage")
                                .addClass("alert-success")
                                .html('<i class="fas fa-check-circle"></i> ' + response.message + '<br><small>Hãy dùng mật khẩu này để đăng nhập ngay.</small>')
                                .fadeIn();
                        } else {
                            $("#alertMessage")
                                .addClass("alert-danger")
                                .html('<i class="fas fa-exclamation-circle"></i> ' + response.message)
                                .fadeIn();
                        }
                    },
                    error: function () {
                        btn.prop("disabled", false).html(originalText);
                        $("#alertMessage")
                            .addClass("alert-danger")
                            .text("Đã xảy ra lỗi hệ thống. Vui lòng thử lại.")
                            .fadeIn();
                    }
                });
            });
        });
    </script>
}